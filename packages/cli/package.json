{
  "name": "@hyphacommerce/cli",
  "version": "0.1.0-beta.3",
  "description": "Hosting Hypha: `hypha init` writes a deployment, `hypha deploy` runs it on a server or on Cloudflare Workers, with the apps `hypha apps` lists beside it.",
  "homepage": "https://hyphacommerce.com",
  "bugs": "https://github.com/hyphacommerce/hypha/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyphacommerce/hypha.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hypha": "./src/main.ts"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "bin": {
      "hypha": "./dist/main.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('../../hypha.config.schema.json', 'templates/hypha.config.schema.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "citty": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
