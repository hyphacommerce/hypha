{
  "name": "@hypha/app",
  "version": "0.1.0",
  "private": true,
  "description": "The SDK for Hypha app authors: manifest types, signature checks, the OAuth client with PKCE, extension-point handlers and session tokens. Web APIs only, so it runs on Node and Workers alike.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./signature": "./src/signature.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hypha/sdk": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
