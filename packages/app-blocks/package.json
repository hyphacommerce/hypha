{
  "name": "@hyphacommerce/app-blocks",
  "version": "0.1.0-beta.3",
  "description": "Hypha's declarative app blocks, version 1: the JSON Schema, TypeScript types, a validator and the reference React renderer on Astryx.",
  "homepage": "https://hyphacommerce.com",
  "bugs": "https://github.com/hyphacommerce/hypha/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyphacommerce/hypha.git",
    "directory": "packages/app-blocks"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./schema/block.v1.json": "./schema/block.v1.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./schema/block.v1.json": "./schema/block.v1.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.1",
    "@stylexjs/stylex": "0.19.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jiti": "2.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.1",
    "react": ">=19.0.0"
  }
}
