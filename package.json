{
  "name": "hypha-workspace",
  "private": true,
  "description": "The TypeScript apps and packages of Hypha (design note 0011). The Rust crates are the Cargo workspace.",
  "scripts": {
    "sdk:generate": "pnpm --filter @hypha/sdk generate",
    "sdk:check": "pnpm --filter @hypha/sdk check",
    "emails:build": "pnpm --filter @hypha/emails build",
    "emails:check": "pnpm --filter @hypha/emails check",
    "dev": "bash scripts/dev.sh",
    "prod": "bash scripts/prod.sh",
    "hypha": "node packages/cli/src/main.ts",
    "seed": "node scripts/seed.mjs",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "storefront:dev": "pnpm --filter storefront dev",
    "storefront:build": "pnpm --filter storefront build",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint:react": "react-doctor -y --no-telemetry"
  },
  "devDependencies": {
    "react-doctor": "0.9.18",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
