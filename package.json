{
  "name": "hypha-workspace",
  "private": true,
  "description": "The TypeScript apps and packages of Hypha. The Rust crates are the Cargo workspace.",
  "scripts": {
    "sdk:generate": "pnpm --filter @hyphacommerce/sdk generate",
    "sdk:check": "pnpm --filter @hyphacommerce/sdk check",
    "emails:build": "pnpm --filter @hyphacommerce/emails build",
    "emails:check": "pnpm --filter @hyphacommerce/emails check",
    "dev": "bash scripts/dev.sh",
    "prod": "bash scripts/prod.sh",
    "hypha": "node packages/cli/src/main.ts",
    "seed": "node scripts/seed.mjs",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "storefront:dev": "pnpm --filter storefront dev",
    "storefront:build": "pnpm --filter storefront build",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint:react": "react-doctor -y --no-telemetry",
    "packages:build": "pnpm -r --filter './packages/*' run build",
    "packages:check": "pnpm packages:build && node scripts/check-packages.mjs",
    "starters:check": "pnpm packages:build && node scripts/check-starters.mjs"
  },
  "devDependencies": {
    "react-doctor": "0.9.18",
    "tsdown": "0.23.1",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
