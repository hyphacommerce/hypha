{
  "name": "hypha-workspace",
  "private": true,
  "description": "The TypeScript apps and packages of Hypha (design note 0011). The Rust crates are the Cargo workspace.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sdk:generate": "pnpm --filter @hypha/sdk generate",
    "sdk:check": "pnpm --filter @hypha/sdk check",
    "dev": "bash scripts/dev.sh",
    "prod": "bash scripts/prod.sh",
    "seed": "node scripts/seed.mjs",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "storefront:dev": "pnpm --filter storefront dev",
    "storefront:build": "pnpm --filter storefront build",
    "typecheck": "pnpm -r typecheck"
  }
}
