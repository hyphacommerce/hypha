/target
# The API key `pnpm dev` makes (scripts/dev.sh).
/.dev-secret-key
# Deployments `pnpm hypha init` writes: they hold secrets.
/hypha-deploy*/
# Deployments' own host crates (`hypha deploy` with spores from outside).
/.hypha-build/
# TypeScript apps and packages
node_modules/
dist/
.next/
.cloudflare/
.wrangler/
.vinext/
*.tsbuildinfo
.env*.local
.dev.vars
next-env.d.ts

# Worktrees Claude Code creates for parallel agents.
/.claude/worktrees/

# macOS Finder metadata
.DS_Store

# The demo store's generated photos: used by `pnpm seed`, kept out of the repository.
/scripts/seed-assets/images/*
!/scripts/seed-assets/images/.gitkeep
