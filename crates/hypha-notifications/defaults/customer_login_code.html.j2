{% extends "layout" %}

{% block preheader %}Enter this code to sign in to {{ shop.name }}.{% endblock %}

{% block content %}
<p
  style="font-size:22px;line-height:30px;font-weight:700;color:#18181b;margin:8px 0 16px;margin-top:8px;margin-right:0;margin-bottom:16px;margin-left:0">
  Your sign-in code
</p>
<p
  style="font-size:15px;line-height:24px;color:#18181b;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
  Enter this code to sign in to {{ shop.name }}. It works for {{ expires_in_minutes }} minutes.
</p>
<table
  align="center"
  width="100%"
  border="0"
  cellpadding="0"
  cellspacing="0"
  role="presentation"
  style="background-color:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;margin:8px 0 24px">
  <tbody>
    <tr>
      <td style="padding:16px 20px">
        <p
          style="font-size:32px;line-height:40px;font-weight:700;letter-spacing:0.3em;text-align:center;color:#18181b;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
          {{ code }}
        </p>
      </td>
    </tr>
  </tbody>
</table>
{% if shop.url %}
  <table
    align="center"
    width="100%"
    border="0"
    cellpadding="0"
    cellspacing="0"
    role="presentation"
    style="margin:8px 0 24px">
    <tbody>
      <tr>
        <td>
          <a
            href="{{ link }}"
            style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:{{ brand.accent }};color:#ffffff;font-size:15px;font-weight:600;border-radius:6px;padding:12px 22px;padding-top:12px;padding-right:22px;padding-bottom:12px;padding-left:22px"
            target="_blank"
            ><span
              ><!--[if mso]><i style="mso-font-width:366.66666666666663%;mso-text-raise:18px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span
            ><span
              style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px"
              >Sign in</span
            ><span
              ><!--[if mso]><i style="mso-font-width:366.66666666666663%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span
            ></a
          >
        </td>
      </tr>
    </tbody>
  </table>
  <p
    style="font-size:13px;line-height:20px;color:#71717a;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
    If the button doesn't work, copy this link into your browser:<br /><a
      href="{{ link }}"
      style="color:{{ brand.accent }};text-decoration-line:none;word-break:break-all"
      target="_blank"
      >{{ link }}</a
    >
  </p>
{% endif %}
<p
  style="font-size:13px;line-height:20px;color:#71717a;margin:0;margin-top:16px;margin-bottom:0;margin-left:0;margin-right:0">
  If you didn't ask for a code, you can ignore this email: nobody can sign in without it.
</p>
{% endblock %}
