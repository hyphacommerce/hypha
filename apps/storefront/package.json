{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Hypha's storefront: a server-rendered shop on Next.js, vinext and Astryx (design notes 0023, 0024).",
  "type": "module",
  "imports": {
    "#api-fetch": {
      "workerd": "./lib/api-fetch.workerd.ts",
      "default": "./lib/api-fetch.ts"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "node scripts/clean-next-types.mjs && tsc --noEmit",
    "theme:build": "astryx theme build theme/shopTheme.ts --out theme/shop.css",
    "theme:check": "astryx theme build theme/shopTheme.ts --out theme/shop.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.1",
    "@astryxdesign/theme-neutral": "0.7.1",
    "@heroicons/react": "2.2.0",
    "@hypha/sdk": "workspace:*",
    "@hypha/storefront-elements": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "@vinext/cloudflare": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-67fa336fd",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "cf": "1.0.0-beta.17",
    "next": "16.4.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
