# Copy to .dev.vars for local development (read by the Cloudflare Vite plugin; ignored
# by git). In production, set them as Worker variables. All are server-side only: the
# browser never sees them.
#
# Where the Hypha API runs.
HYPHA_API_URL=http://127.0.0.1:3917

# A publishable key (hypha_pk_…) for the channel this storefront sells through. Create
# one in the admin: Settings → Channels → the key icon on the channel.
STOREFRONT_KEY=hypha_pk_replace_me

# `folders` (the default): one URL folder per country (/hr/…). `single`: URLs carry no
# country; it lives in a cookie and the country picker changes it.
# STOREFRONT_ROUTING=single

# The signing secret of the app the storefront is registered as in the admin (Settings
# → Apps), whose webhook is this storefront's /api/revalidate: product, price and stock
# changes then refresh the static pages at once instead of within five minutes. The API
# must be allowed to call it (outbound.allow_private for localhost in development).
# HYPHA_WEBHOOK_SECRET=

# Behind your own reverse proxy (not Cloudflare): set to true so cart creation passes on
# the shopper's address that proxy appends to X-Forwarded-For. Leave unset otherwise.
# STOREFRONT_TRUST_X_FORWARDED_FOR=true
