# Copy to .dev.vars for local development (read by the Cloudflare Vite plugin; ignored
# by git). In production, set it as a Worker variable.
#
# Where the Hypha API runs (server-side only; the browser never calls it directly).
HYPHA_API_URL=http://127.0.0.1:3917

# Behind your own reverse proxy (not Cloudflare): set to true so the admin passes on
# the client address that proxy appends to X-Forwarded-For. Leave unset otherwise; a
# browser could put any address there.
# ADMIN_TRUST_X_FORWARDED_FOR=true
