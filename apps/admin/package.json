{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "The Hypha admin panel: Next.js on vinext, Astryx.",
  "type": "module",
  "imports": {
    "#api-fetch": {
      "workerd": "./lib/api-fetch.workerd.ts",
      "default": "./lib/api-fetch.ts"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "test": "node --test lib/*.test.ts",
    "typecheck": "node scripts/clean-next-types.mjs && tsc --noEmit",
    "theme:build": "astryx theme build theme/hyphaTheme.ts --out theme/hypha.css",
    "theme:check": "astryx theme build theme/hyphaTheme.ts --out theme/hypha.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.1",
    "@astryxdesign/richtext": "0.7.1",
    "@astryxdesign/theme-neutral": "0.7.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@hyphacommerce/app-blocks": "workspace:*",
    "@hyphacommerce/app-bridge-host": "workspace:*",
    "@hyphacommerce/sdk": "workspace:*",
    "@lexical/code": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@lezer/highlight": "1.2.5",
    "@stylexjs/stylex": "0.19.1",
    "codemirror": "6.0.2",
    "lexical": "0.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "uqr": "0.1.3",
    "vinext": "1.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "cf": "1.0.0-beta.17",
    "next": "16.4.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
