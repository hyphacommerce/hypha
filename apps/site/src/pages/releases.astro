---
import PageHead from "../components/PageHead.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { posts } from "../lib/posts";

const releases = await posts((p) => p.data.release);
---

<Base title="Releases" description="Hypha's release announcements.">
  <div class="wrap">
    <PageHead
      title="Releases"
      lede="What each release brings, in words. The complete list of changes is in the changelog."
    >
      <p class="more"><a href="/changelog">Read the changelog</a></p>
    </PageHead>
    <PostList
      posts={releases}
      empty="No releases yet: the first public preview, v0.1.0, is in preparation."
    />
  </div>
</Base>

<style>
  .more {
    margin-top: 12px;
  }
</style>
