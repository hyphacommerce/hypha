---
import PostArchive from "../../components/PostArchive.astro";
import Base from "../../layouts/Base.astro";
import { posts } from "../../lib/posts";

const all = await posts();
---

<Base title="Blog" description="Building Hypha in the open: releases, design decisions and guides.">
  <PostArchive
    title="Blog"
    lede="Building Hypha in the open: releases, design decisions and guides."
    posts={all}
    links={[
      { href: "/releases", label: "Release posts only" },
      { href: "/rss.xml", label: "RSS feed" },
    ]}
    empty="The first posts are on their way."
  />
</Base>
