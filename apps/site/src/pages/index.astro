---
import logomarkOnDark from "../../../admin/public/brand/hypha-logomark-on-dark.svg?url";
import logomark from "../../../admin/public/brand/hypha-logomark.svg?url";
import Network from "../components/Network.astro";
import { EMAIL, GITHUB, SPONSOR } from "../consts";
import Base from "../layouts/Base.astro";
import { software, sourceCode } from "../lib/seo";

const SATELLITES = [
  ["Spores", "Rust plugins"],
  ["Apps", "any language, via API"],
  ["Storage", "Postgres · S3-compatible"],
  ["Hosting", "VPS · serverless edge"],
  ["Frontends", "any framework"],
  ["AI agents", "over MCP"],
];

// Which species come in which size; `null` is a combination that's never created.
const MATRIX: [string, string, (number | null)[]][] = [
  ["Oyster", "OYS", [14, 19, 24]],
  ["Shiitake", "SHI", [null, 21, 27]],
  ["Lion's mane", "LIO", [16, 20, 25]],
  ["King trumpet", "KTR", [18, 23, null]],
];

const FIELDS: [string, string, boolean][] = [
  ["Harvest window", "10–14 days", false],
  ["Difficulty", "Easy", false],
  ["Supplier lot", "LT-2210-B", true],
  ["Landed cost", "€6.40", true],
];

const PROVIDERS = [
  ["hosting", "Any Linux VPS"],
  ["hosting", "Serverless edge"],
  ["database", "Postgres"],
  ["database", "Serverless Postgres"],
  ["storage", "S3-compatible"],
  ["email", "Transactional email"],
  ["payments", "Payment providers"],
  ["search", "Search engine"],
];

const PROPOSAL = [
  ["Oyster grow kit", "Large", "€24.00", "€26.00", "+8.3%"],
  ["Lion's mane grow kit", "Medium", "€19.00", "€20.50", "+7.9%"],
  ["Shiitake log", "Small", "€12.00", "€12.90", "+7.5%"],
];
---

<Base schema={[software, sourceCode]}>
  <div class="page">
    <Network />

    <section class="hero" data-hy-zone="hero">
      <div class="hero-copy" data-hy-clear>
        <span class="pill"><span></span>Open source · Rust core</span>
        <h1>Commerce, grown as a network.</h1>
        <p class="lede">
          Open-source commerce you host yourself, on a server that costs about €5 a month. Extend it
          with apps and plugins, and let AI agents help run it.
        </p>
        <div class="ctas">
          <a class="btn primary" href="/docs/getting-started">Get started</a>
          <a class="btn" href={GITHUB}>View on GitHub</a>
        </div>
      </div>
    </section>

    <div class="rail-wrap">
      <section class="row" id="own">
        <div class="rail"><span class="node" data-hy-node="1"></span></div>
        <div class="body">
          <div class="head">
            <h2>Own your store. Don't rent it.</h2>
            <div class="links"><a href="/docs/deploy">Self-hosting guide <span>→</span></a></div>
          </div>
          <div class="card costs" data-hy-link="rail">
            <div class="costs-top">
              <label for="sales">Monthly cost at <strong data-sales-label>$20,000</strong> in sales</label>
              <input id="sales" type="range" min="0" max="100000" step="1000" value="20000" />
            </div>
            <div class="cost">
              <div class="who"><strong>Hypha on a VPS</strong><span>any Linux VPS</span></div>
              <div class="meter"><div class="bar"><span class="fill lime" style="width:0.22%"></span></div>
              <span class="price">€5/mo</span></div>
            </div>
            <div class="cost">
              <div class="who"><strong>Hypha on serverless edge</strong><span>entry paid plan</span></div>
              <div class="meter"><div class="bar"><span class="fill lime" style="width:0.22%"></span></div>
              <span class="price">$5/mo</span></div>
            </div>
            <div class="cost">
              <div class="who"><strong>Shopify Basic</strong><span>$39 + 2% of sales</span></div>
              <div class="meter"><div class="bar">
                <span class="fill ink base" data-basic style="width:1.7%"></span><span
                  class="fill fee"
                  data-fee
                  style="width:17.4%"></span>
              </div>
              <span class="price" data-basic-price>$439/mo</span></div>
            </div>
            <div class="cost">
              <div class="who"><strong>Shopify Plus</strong><span>from</span></div>
              <div class="meter"><div class="bar"><span class="fill ink" data-plus style="width:100%"></span></div>
              <span class="price">$2,300/mo</span></div>
            </div>
            <div class="costs-foot">
              <span class="keep">You keep the code, the data and the servers.</span>
              <span>Shopify Basic costs <strong data-saving>$5,208</strong> more a year</span>
            </div>
            <p class="fine">
              List prices in October 2026. Shopify's 2% applies when you don't use Shopify Payments;
              card fees apply everywhere.
            </p>
          </div>
        </div>
      </section>

      <section class="row" id="core">
        <div class="rail"><span class="node" data-hy-node="2"></span></div>
        <div class="body">
          <div class="head">
            <h2>A small core. Everything plugs in.</h2>
            <div class="links">
              <a href="/docs/concepts/architecture">Architecture docs <span>→</span></a>
              <a href="/docs/guides/spores">Write your first spore <span>→</span></a>
            </div>
          </div>
          <div class="core-grid">
            <div class="core-cell" data-hy-id="core" data-hy-link="rail">
              <div class="core">
                <img class="on-light" src={logomarkOnDark} alt="" width="64" height="64" />
                <img class="on-dark" src={logomark} alt="" width="64" height="64" />
                <strong>Hypha core</strong>
                <span>Rust</span>
              </div>
            </div>
            {
              SATELLITES.map(([name, detail], i) => (
                <div class={`sat sat-${i + 1}`} data-hy-link="core">
                  <div class="card sat-card">
                    <strong>{name}</strong>
                    <span>{detail}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="row" id="agents">
        <div class="rail"><span class="node" data-hy-node="3"></span></div>
        <div class="body">
          <div class="head">
            <h2>Built for merchants, developers and agents.</h2>
            <div class="links"><a href="/docs/guides/agents">Agents and MCP docs <span>→</span></a></div>
          </div>
          <div class="people">
            <dl class="roles">
              <div><dt>merchants</dt><dd>Run the store from one admin.</dd></div>
              <div><dt>developers</dt><dd>Extend it in Rust or any language.</dd></div>
              <div><dt>agents</dt><dd>Propose the busywork. A person approves.</dd></div>
            </dl>
            <div class="card proposal" data-hy-link="rail" data-proposal="pending">
              <div class="p-head">
                <span class="ai">AI</span>
                <div class="p-who"><strong>pricing-agent</strong><span>proposes 3 price changes</span></div>
                <span class="state" data-state aria-live="polite">Needs approval</span>
              </div>
              <p class="why">
                <strong>Why:</strong> these sold 90% of stock in 14 days, and comparable kits sell for 8–12%
                more.
              </p>
              {
                PROPOSAL.map(([name, variant, before, after, delta]) => (
                  <div class="p-row">
                    <div class="p-item">
                      <span>{name}</span>
                      <small>{variant}</small>
                    </div>
                    <del>{before}</del>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                    <div class="p-after">
                      <ins>{after}</ins>
                      <small>{delta}</small>
                    </div>
                  </div>
                ))
              }
              <div class="p-foot pending-only">
                <span>Nothing changes until a person approves.</span>
                <div class="p-actions">
                  <button type="button" class="btn small" data-act="rejected">Reject</button>
                  <button type="button" class="btn small primary" data-act="approved">Approve</button>
                </div>
              </div>
              <div class="p-foot decided-only">
                <span data-note aria-live="polite"></span>
                <button type="button" class="undo" data-act="pending">Undo</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="row" id="catalogue">
        <div class="rail"><span class="node" data-hy-node="4"></span></div>
        <div class="body">
          <div class="head">
            <h2>Catalogues as complex as your products.</h2>
            <div class="links"><a href="/docs/concepts/catalog">Catalogue docs <span>→</span></a></div>
          </div>
          <div class="card options" data-hy-link="rail">
            <div class="card-title"><strong>As many options as you need</strong><span>one product, every way it's sold</span></div>
            <div class="opt-row">
              <span class="opt-who">Shopify</span>
              <div class="chips">
                <span class="chip">Species</span><span class="chip">Size</span><span class="chip">Substrate</span><span
                  class="chip limit">limit: 3</span>
              </div>
            </div>
            <div class="opt-row">
              <span class="opt-who">Hypha</span>
              <div class="chips">
                <span class="chip">Species</span><span class="chip">Size</span><span class="chip">Substrate</span><span
                  class="chip new">Spawn type</span><span class="chip new">Gift wrap</span><span class="chip more"
                  >+ add more</span>
              </div>
            </div>
          </div>
          <div class="pair">
            <div class="card" data-hy-link="rail">
              <div class="card-title"><strong>Only the variants that exist</strong><span>10 of 12 · species × size</span></div>
              <div class="matrix" role="table" aria-label="Variants by species and size">
                <div class="m-row" role="row">
                  <span role="columnheader"><span class="sr-only">Species</span></span>
                  <span class="m-size" role="columnheader">S</span>
                  <span class="m-size" role="columnheader">M</span>
                  <span class="m-size" role="columnheader">L</span>
                </div>
                {
                  MATRIX.map(([name, code, prices]) => (
                    <div class="m-row" role="row">
                      <span class="m-name" role="rowheader">
                        {name}
                      </span>
                      {prices.map((p, i) =>
                        p == null ? (
                          <div class="cell none" role="cell">
                            not sold
                          </div>
                        ) : (
                          <div class="cell" role="cell">
                            <strong>€{p}</strong>
                            <small>
                              {code}-{"SML"[i]}
                            </small>
                          </div>
                        ),
                      )}
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="card fields" data-hy-link="rail">
              <div class="card-title"><strong>Custom fields everywhere</strong><span>product · variant · order</span></div>
              {
                FIELDS.map(([name, value, staff]) => (
                  <div class="field">
                    <div>
                      <span>{name}</span>
                      <strong>{value}</strong>
                    </div>
                    <span class={staff ? "badge staff" : "badge"}>{staff ? "Staff only" : "Storefront"}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="row" id="sponsor">
        <div class="rail"><span class="node" data-hy-node="5"></span></div>
        <div class="body">
          <div class="head">
            <h2>Runs on what you already use.</h2>
            <div class="links"><a href="/docs/deploy">Deployment docs <span>→</span></a></div>
          </div>
          <div class="providers">
            {
              PROVIDERS.map(([role, name]) => (
                <div class="card provider" data-hy-chain="providers">
                  <span>{role}</span>
                  <strong>{name}</strong>
                </div>
              ))
            }
          </div>
          <div class="ask" data-hy-link="rail">
            <p>
              <strong>Hosting or database company?</strong>{" "}
              <span>Sponsor Hypha to fund the open core and reach the developers who build on it.</span>
            </p>
            <div class="ask-actions">
              <a class="btn" href={SPONSOR}>Become a sponsor →</a>
              <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
          </div>
        </div>
      </section>

      <section class="row" id="roadmap">
        <div class="rail"><span class="node" data-hy-node="6"></span></div>
        <div class="body">
          <div class="head">
            <h2>Where it grows next.</h2>
            <div class="links"><a href="/changelog">Changelog <span>→</span></a></div>
          </div>
          <div class="stages">
            <div class="card stage now" data-hy-chain="roadmap">
              <div class="stage-head"><span class="tag">Now</span><span>shipping</span></div>
              <ul>
                <li>Rust core and admin</li>
                <li>Spores and apps</li>
                <li>Agents over MCP</li>
              </ul>
            </div>
            <div class="card stage next" data-hy-chain="roadmap">
              <div class="stage-head"><span class="tag">Next</span><span>in progress</span></div>
              <ul>
                <li>Agentic shopping with <a href="https://ucphub.ai">ucphub.ai</a></li>
                <li>Suppliers and purchase orders</li>
                <li>Discounts</li>
                <li>Analytics</li>
              </ul>
            </div>
            <div class="card stage later" data-hy-chain="roadmap">
              <div class="stage-head"><span class="tag">Later</span><span>exploring</span></div>
              <ul>
                <li>Multiple stores per deployment</li>
                <li>B2B accounts and quotes</li>
                <li>Accounting and carrier spores</li>
                <li>Spore directory</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="closing" data-hy-zone="close">
      <div class="closing-copy" data-hy-clear>
        <h2>Commerce doesn't have to be expensive.</h2>
        <p>Open source. Self-hosted. About €5 a month.</p>
        <div class="ctas">
          <a class="btn primary" href="/docs/getting-started">Get started</a>
          <a class="btn" href={SPONSOR}>Sponsor Hypha</a>
        </div>
        <p class="contact">Questions, or want to sponsor? Write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  // The cost comparison: Shopify Basic's 2% grows with sales; Hypha's cost doesn't.
  const money = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
  const slider = document.querySelector<HTMLInputElement>("#sales");
  const set = (sel: string, fn: (el: HTMLElement) => void) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (el) fn(el);
  };
  const update = () => {
    const sales = Number(slider?.value ?? 20000);
    const basic = 39 + 0.02 * sales;
    const max = Math.max(2300, basic);
    const pct = (v: number) => `${(v / max) * 100}%`;
    set("[data-sales-label]", (el) => (el.textContent = money(sales)));
    set("[data-basic-price]", (el) => (el.textContent = `${money(basic)}/mo`));
    set("[data-saving]", (el) => (el.textContent = money(Math.max(0, (basic - 5) * 12))));
    set("[data-basic]", (el) => {
      el.style.width = pct(39);
      el.classList.toggle("alone", sales === 0);
    });
    set("[data-fee]", (el) => (el.style.width = sales ? pct(0.02 * sales) : "0"));
    set("[data-plus]", (el) => (el.style.width = pct(2300)));
    for (const el of document.querySelectorAll<HTMLElement>(".fill.lime")) el.style.width = pct(5);
  };
  slider?.addEventListener("input", update);
  update();

  // The agent's proposal: approve or reject it, then undo.
  const proposal = document.querySelector<HTMLElement>("[data-proposal]");
  const STATES: Record<string, [string, string]> = {
    pending: ["Needs approval", ""],
    approved: ["Approved", "Approved by Maja just now. 3 prices updated."],
    rejected: ["Rejected", "Rejected by Maja. No prices changed."],
  };
  proposal?.addEventListener("click", (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>("[data-act]")?.dataset.act;
    if (!act || !STATES[act]) return;
    proposal.dataset.proposal = act;
    const [label, note] = STATES[act];
    proposal.querySelector("[data-state]")!.textContent = label;
    proposal.querySelector("[data-note]")!.textContent = note;
  });
</script>

<style>
  .page {
    position: relative;
    overflow-x: clip;
    --rail: 56px;
    --mono: var(--font-mono);
  }

  .page > section,
  .rail-wrap {
    position: relative;
    z-index: 1;
  }

  h1,
  h2 {
    font-weight: 600;
    text-wrap: balance;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 24px;
    border-radius: 12px;
    border: 1px solid var(--rule-strong);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn:hover {
    border-color: var(--text-faint);
  }

  .btn.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink-on-lime);
    font-weight: 600;
  }

  .btn.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .btn.small {
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 14px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .text-link {
    padding: 10px 4px;
    color: var(--text-muted);
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 4px;
  }

  .text-link:hover {
    color: var(--text);
  }

  /* Hero */
  .hero {
    min-height: min(880px, calc(100vh - 64px));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 96px 20px 150px;
  }

  .hero-copy,
  .closing-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .hero-copy {
    max-width: 880px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 8px;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--bg);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .pill span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--sig-stroke);
  }

  h1 {
    font-size: clamp(46px, 8.4vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 620px;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .hero .ctas {
    padding-top: 4px;
  }

  /* The sections hang off a rail on the left, where the trunk runs. */
  .rail-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .row {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    padding-block: clamp(56px, 8vw, 112px);
  }

  .rail {
    position: relative;
  }

  .node {
    position: absolute;
    top: 14px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--text);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }

  h2 {
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: 10px;
    border: 1px solid var(--rule-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--text-faint);
  }

  .links a span {
    color: var(--text-accent);
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: 20px 22px;
  }

  .card-title {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: space-between;
    align-items: baseline;
  }

  .card-title strong {
    font-size: 15px;
    font-weight: 600;
  }

  .card-title span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  /* Costs */
  .costs {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(20px, 3vw, 32px);
  }

  .costs-top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }

  .costs-top label {
    font-size: 14px;
    color: var(--text-muted);
  }

  .costs-top strong {
    color: var(--text);
    font-family: var(--mono);
    font-weight: 600;
  }

  .costs-top input {
    flex: 1 1 220px;
    max-width: 360px;
    accent-color: #7ea602;
  }

  .cost {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    align-items: center;
  }

  .who {
    flex: 1 1 190px;
    max-width: 230px;
    display: flex;
    flex-direction: column;
  }

  .who strong {
    font-size: 15px;
    font-weight: 600;
  }

  .who span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  .meter {
    flex: 999 1 260px;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .bar {
    flex: 1;
    display: flex;
    height: 28px;
    min-width: 0;
  }

  .fill {
    height: 100%;
    transition: width 0.25s ease;
  }

  .fill.lime {
    min-width: 7px;
    border-radius: 6px;
    background: var(--accent);
    box-shadow: inset 0 0 0 1px var(--sig-stroke);
  }

  .fill.ink {
    min-width: 4px;
    border-radius: 6px;
    background: var(--text);
  }

  .fill.base:not(.alone) {
    border-radius: 6px 0 0 6px;
  }

  .fill.fee {
    border-radius: 0 6px 6px 0;
    background: repeating-linear-gradient(135deg, var(--text) 0 1.5px, transparent 1.5px 6px);
