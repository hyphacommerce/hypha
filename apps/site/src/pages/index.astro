---
import Proposal from "../components/Proposal.astro";
import Weave from "../components/Weave.astro";
import { GITHUB, SPONSOR } from "../consts";
import Base from "../layouts/Base.astro";

// The demo store's oyster kit: which species come in which size. Pink and golden oysters
// keep badly, so they're sold in the starter block only; those two cells never exist.
const species = ["Pearl oyster", "Blue oyster", "Pink oyster", "Golden oyster"];
const sizes = ["Starter", "Family"];
const price: Record<string, string> = {
  "Pearl oyster|Starter": "€24",
  "Pearl oyster|Family": "€39",
  "Blue oyster|Starter": "€24",
  "Blue oyster|Family": "€39",
  "Pink oyster|Starter": "€26",
  "Golden oyster|Starter": "€26",
};
---

<Base>
  <div class="weave-host">
    <Weave />

    <section class="hero">
      <div class="hero-web" data-bloom></div>
      <div class="wrap hero-copy">
        <p class="preview">Open source, in public preview</p>
        <h1>Commerce, grown as a network.</h1>
        <p class="lede">
          An open-source store you own and host yourself. Extend it with apps and plugins, let AI
          agents help run it, and pay about five euros a month for the server.
        </p>
        <div class="ctas">
          <a class="button primary" href="/docs/getting-started">Get started</a>
          <a class="button" href={GITHUB}>View on GitHub</a>
        </div>
      </div>
    </section>

    <section class="section" data-weave="left">
      <div class="wrap">
        <h2>Own your store. Stop renting it.</h2>
        <p class="sub">
          Hosted platforms charge every month, take a cut of every sale and keep your data. With
          Hypha, the code, the database and the server are yours.
        </p>
        <div class="prices">
          <div class="price ours">
            <p class="amount">€5</p>
            <p>Hypha on a small VPS, everything included</p>
          </div>
          <div class="price ours">
            <p class="amount">$5</p>
            <p>Hypha on Cloudflare Workers, with Neon's free Postgres</p>
          </div>
          <div class="price theirs">
            <p class="amount">$39</p>
            <p>Shopify Basic, plus 2% of sales unless you use Shopify Payments</p>
          </div>
          <div class="price theirs">
            <p class="amount">$2,300</p>
            <p>Shopify Plus, to start</p>
          </div>
        </div>
        <p class="fine">Per month, list prices in October 2026. Card fees apply everywhere.</p>
      </div>
    </section>

    <section class="section" data-weave="right">
      <div class="wrap">
        <h2>A small core. Everything else plugs in.</h2>
        <p class="sub">
          A hypha is one thread in a much bigger fungal network. Hypha works the same way: the core
          does commerce, and the rest connects to it.
        </p>
        <div class="network">
          <div class="hub" data-hub="core"><strong>Hypha core</strong></div>
          <div class="node n1" data-tie="core"><strong>Spores</strong><span>Rust plugins</span></div>
          <div class="node n2" data-tie="core"><strong>Apps</strong><span>Any language</span></div>
          <div class="node n3" data-tie="core">
            <strong>Storage</strong><span>Postgres, S3, R2</span>
          </div>
          <div class="node n4" data-tie="core">
            <strong>Hosting</strong><span>A server or Workers</span>
          </div>
          <div class="node n5" data-tie="core">
            <strong>Frontends</strong><span>Ours or your own</span>
          </div>
          <div class="node n6" data-tie="core"><strong>Agents</strong><span>Over MCP</span></div>
        </div>
      </div>
    </section>

    <section class="section" data-weave="left">
      <div class="wrap">
        <h2>Built for merchants, developers and agents.</h2>
        <div class="three">
          <article data-tie="thread">
            <h3>Merchants</h3>
            <p>Run the store from an admin made for big, messy catalogues.</p>
          </article>
          <article data-tie="thread">
            <h3>Developers</h3>
            <p>Build custom apps and storefronts on typed APIs. No fork to maintain.</p>
          </article>
          <article data-tie="thread">
            <h3>Agents</h3>
            <p>Help build it, and help run it. They ask before changing anything.</p>
          </article>
        </div>
        <figure class="agent-shot">
          <Proposal />
          <figcaption>An agent's change, previewed exactly, waiting for someone to approve it.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" data-weave="right">
      <div class="wrap">
        <h2>Sell what you actually sell.</h2>
        <p class="sub">
          No three-option limit, no variants for combinations you don't stock, and custom fields
          wherever you need them.
        </p>
        <div class="catalogue">
          <figure class="card matrix">
            <table>
              <caption>Oyster grow kit: six variants, the six that exist</caption>
              <thead>
                <tr>
                  <td></td>
                  {sizes.map((s) => <th scope="col">{s}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  species.map((sp) => (
                    <tr>
                      <th scope="row">{sp}</th>
                      {sizes.map((s) => {
                        const p = price[`${sp}|${s}`];
                        return p ? <td class="is">{p}</td> : <td class="isnt">not sold</td>;
                      })}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </figure>
          <figure class="card fields">
            <figcaption>Its custom fields</figcaption>
            <dl>
              <div><dt>Species</dt><dd>Pleurotus ostreatus <small>filterable</small></dd></div>
              <div><dt>Difficulty</dt><dd>Beginner <small>filterable</small></dd></div>
              <div><dt>Works with</dt><dd>Fruiting chamber <small>product link</small></dd></div>
              <div><dt>Supplier code</dt><dd>MW-OYS-ST <small>staff only</small></dd></div>
            </dl>
          </figure>
        </div>
        <p class="also">Also built in: a media library and faceted search.</p>
      </div>
    </section>

    <section class="section" data-weave="left">
      <div class="wrap">
        <h2>Runs where you already are.</h2>
        <ul class="platforms">
          <li>Cloudflare</li>
          <li>Hetzner</li>
          <li>Any VPS</li>
          <li>Neon</li>
          <li>Postgres</li>
          <li>R2</li>
          <li>S3</li>
          <li>Resend</li>
          <li>Stripe</li>
          <li>Meilisearch</li>
        </ul>
        <div class="ask">
          <p>
            <strong>Run a hosting or database company?</strong> Sponsor Hypha and help new stores
            start on your platform.
          </p>
          <a class="button" href={SPONSOR}>Become a sponsor</a>
        </div>
      </div>
    </section>

    <section class="section" data-weave="right">
      <div class="wrap">
        <h2>What's next.</h2>
        <div class="roadmap">
          <div data-tie="thread">
            <h3>Now</h3>
            <ul>
              <li>Catalogue, checkout and orders</li>
              <li>Apps, spores and agents</li>
              <li>Servers and Cloudflare</li>
            </ul>
          </div>
          <div data-tie="thread">
            <h3>Next</h3>
            <ul>
              <li>Agentic shopping with ucphub.ai</li>
              <li>Suppliers and purchase orders</li>
              <li>Discounts</li>
              <li>Analytics</li>
            </ul>
          </div>
          <div data-tie="thread">
            <h3>Later</h3>
            <ul>
              <li>B2B</li>
              <li>QuickBooks, DHL and FedEx</li>
              <li>Reviews and wishlists</li>
              <li>Cloudflare D1</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="closing-web" data-bloom="end"></div>
      <div class="wrap closing-copy">
        <h2>Commerce doesn't have to be expensive.</h2>
        <p>Hypha is free and open source. Sponsors help keep it that way.</p>
        <div class="ctas">
          <a class="button primary" href="/docs/getting-started">Get started</a>
          <a class="button" href={SPONSOR}>Sponsor Hypha</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .weave-host {
    position: relative;
    overflow-x: clip;
  }

  .weave-host > section {
    position: relative;
    z-index: 1;
  }

  /* Room on both sides for the thread's lanes. */
  .weave-host .wrap {
    max-width: 1080px;
    padding-inline: clamp(44px, 6vw, 72px);
  }

  h2 {
    font-size: clamp(2rem, 4.4vw, 3.3rem);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  h3 {
    font-size: 1.3rem;
    letter-spacing: -0.015em;
  }

  .sub {
    margin-top: 18px;
    max-width: 52ch;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Hero: centred, over the web. The veil keeps the text readable on top of it. */
  .hero {
    display: grid;
    place-items: center;
    min-height: min(86vh, 820px);
    padding-block: 72px 120px;
    text-align: center;
  }

  .hero-web {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .hero-copy::before {
    content: "";
    position: absolute;
    inset: -12% -4%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--bg) 55%, transparent);
  }

  .preview {
    margin-bottom: 26px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--lime-soft);
    color: var(--text-accent);
    font-size: 0.9rem;
    font-weight: 560;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    font-weight: 640;
    max-width: 10ch;
  }

  .lede {
    margin-top: 26px;
    max-width: 44ch;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .hero .ctas {
    justify-content: center;
  }

  /* Sections */
  .section {
    padding-block: clamp(72px, 10vw, 128px);
  }

  /* Prices: ours, then theirs. */
  .prices {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-top: 56px;
  }

  .price {
    padding-top: 16px;
    border-top: 2px solid var(--text);
  }

  .price.theirs {
    border-top-color: var(--rule-strong);
  }

  .amount {
    margin-bottom: 8px;
    font-size: clamp(2.6rem, 5vw, 3.8rem);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .theirs .amount {
    color: var(--text-faint);
  }

  .price > p:last-child {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .fine {
    margin-top: 28px;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  /* The network: a hub with what plugs into it around it. Boxes are opaque, so the ties
     drawn behind them only show in the gaps. */
  .network {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "n1 n2 n3"
      ". hub ."
      "n4 n5 n6";
    gap: 48px;
    margin-top: 56px;
  }

  .hub,
  .node {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--bg-raised);
    border: 1px solid var(--rule-strong);
  }

  .hub {
    grid-area: hub;
    place-items: center;
    padding: 22px;
    border-radius: 999px;
    background: var(--graphite);
    border-color: var(--graphite);
    color: var(--on-graphite);
    font-size: 1.2rem;
  }

  .node span {
    color: var(--text-muted);
    font-size: 0.93rem;
  }

  .n1 {
    grid-area: n1;
  }
  .n2 {
    grid-area: n2;
  }
  .n3 {
    grid-area: n3;
  }
  .n4 {
    grid-area: n4;
  }
  .n5 {
    grid-area: n5;
  }
  .n6 {
    grid-area: n6;
  }

  /* Three audiences */
  .three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: 80px;
  }

  .three article {
    padding-top: 20px;
  }

  .three p {
    margin-top: 8px;
    color: var(--text-muted);
  }

  .agent-shot {
    max-width: 560px;
    margin: 72px auto 0;
  }

  .agent-shot figcaption {
    margin-top: 14px;
    text-align: center;
    font-size: 0.93rem;
    color: var(--text-faint);
  }

  /* Catalogue */
  figure {
    margin: 0;
  }

  .catalogue {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    margin-top: 48px;
    align-items: start;
  }

  .card {
    padding: 22px;
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
  }

  .matrix table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 6px;
    font-size: 0.93rem;
  }

  .matrix caption,
  .fields figcaption {
    margin-bottom: 12px;
    text-align: left;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .matrix th {
    font-weight: 500;
    color: var(--text-muted);
    text-align: left;
  }

  .matrix thead th {
    text-align: center;
  }

  .matrix td {
    height: 42px;
    border-radius: 8px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .matrix .is {
    background: var(--lime);
    color: var(--ink-on-lime);
    font-weight: 600;
  }

  .matrix .isnt {
    border: 1px dashed var(--rule-strong);
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  .fields dl {
    margin: 0;
  }

  .fields dl div {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    font-size: 0.93rem;
  }

  .fields dt {
    color: var(--text-muted);
  }

  .fields dd {
    margin: 0;
  }

  .fields small {
    display: block;
    color: var(--text-faint);
    font-size: 0.82rem;
  }

  .also {
    margin-top: 28px;
    color: var(--text-muted);
  }

  /* Platforms: names only. */
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text-muted);
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    margin-top: 56px;
    padding: 20px 24px;
    border-radius: var(--radius-lg);
    background: var(--lime-soft);
  }

  .ask p {
    max-width: 52ch;
  }

  /* Roadmap */
  .roadmap {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: 80px;
  }

  .roadmap > div {
    padding-top: 20px;
  }

  .roadmap ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
  }

  .roadmap li {
    padding: 8px 0;
    border-top: 1px solid var(--rule);
  }

  /* Closing: one column, the second web opening behind it. */
  .closing {
    display: grid;
    place-items: center;
    min-height: 620px;
    padding-block: 96px;
    text-align: center;
  }

  .closing-web {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .closing-copy {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .closing-copy::before {
    content: "";
    position: absolute;
    inset: -20% 0;
    z-index: -1;
    background: radial-gradient(closest-side, var(--bg) 50%, transparent);
  }

  .closing h2 {
    max-width: 16ch;
  }

  .closing p {
    margin-top: 18px;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .closing .ctas {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .prices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .catalogue,
    .three,
    .roadmap {
      grid-template-columns: minmax(0, 1fr);
    }

    .network {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hub hub"
        "n1 n2"
        "n3 n4"
        "n5 n6";
      gap: 24px;
    }
  }

  @media (max-width: 760px) {
    .weave-host .wrap {
      padding-left: 40px;
      padding-right: 16px;
    }

    .hero .wrap,
    .closing .wrap {
      padding-inline: 16px;
    }
  }
</style>
