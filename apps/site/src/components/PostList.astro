---
import { formatDate, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  empty: string;
}

const { posts, empty } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ol class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <div>
            <h2>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
              {p.data.draft && <span class="draft">Draft</span>}
            </h2>
            <p>{p.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 11em minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }

  time {
    color: var(--text-faint);
    font-size: 0.93rem;
    padding-top: 4px;
  }

  h2 {
    font-size: 1.35rem;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
  }

  p {
    margin-top: 8px;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .draft {
    margin-left: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--lime-soft);
    color: var(--text-accent);
    font-size: 0.75rem;
    font-weight: 560;
    vertical-align: middle;
  }

  .empty {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
