---
// The thread woven behind the landing page: one hypha that grows out of the hero's web,
// runs down a lane beside each section, swings across the gap to the next one, and opens
// into a second web behind the closing section. Lime signals run out along the webs.
//
// The page marks what it hangs on, and this measures it after layout:
// - `data-bloom` on an element: a web of branching filaments filling it, grown from its
//   centre; the first one starts the thread, one with `data-bloom="end"` ends it;
// - `data-weave="left|right"` on a section: the lane the thread takes beside it, with a
//   knot level with the section's heading (one lane, on the left, on phones);
// - `data-hub` (an id) and `data-tie="<hub id>"`: a filament from that hub to the element;
//   `data-tie="thread"` hangs the element from the thread instead.
//
// Kept cheap to scroll: nothing is redrawn per frame. Each piece (a stretch of thread, a
// web, a tie) is drawn once by a CSS transition when the reader reaches it, and signals
// only run on the pieces near the viewport. No filters or masks.
//
// It's decoration: the SVG is hidden from assistive tech and the page reads the same
// without it.
---

<svg class="weave" aria-hidden="true" focusable="false">
  <g class="weave-webs"></g>
  <g class="weave-thread"></g>
  <g class="weave-ties"></g>
</svg>

<script>
  type P = { x: number; y: number };
  type Branch = { pts: P[]; depth: number };

  const NS = "http://www.w3.org/2000/svg";
  const svg = document.querySelector<SVGSVGElement>(".weave");
  const host = svg?.parentElement;
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  // Seeded, so the web keeps its shape from one visit (and one resize) to the next.
  function random(seed: number) {
    let s = seed >>> 0;
    return () => {
      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
      return s / 2 ** 32;
    };
  }

  function make<K extends keyof SVGElementTagNameMap>(
    tag: K,
    attrs: Record<string, string | number>,
    parent: Element,
  ) {
    const el = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    parent.append(el);
    return el;
  }

  const f = (n: number) => n.toFixed(1);
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  // Catmull-Rom through the points, as one cubic Bézier per gap.
  function curves(pts: P[]) {
    const out: string[] = [];
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] ?? pts[i];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] ?? p2;
      out.push(
        `C${f(p1.x + (p2.x - p0.x) / 6)},${f(p1.y + (p2.y - p0.y) / 6)} ${f(p2.x - (p3.x - p1.x) / 6)},${f(p2.y - (p3.y - p1.y) / 6)} ${f(p2.x)},${f(p2.y)}`,
      );
    }
    return out;
  }

  const smooth = (pts: P[]) => `M${f(pts[0].x)},${f(pts[0].y)} ${curves(pts).join(" ")}`;

  // A filament: a random walk that bends a little at each step and sometimes forks.
  function grow(
    rnd: () => number,
    from: P,
    angle: number,
    steps: number,
    step: number,
    depth: number,
    out: Branch[],
    bend: number,
    forks: number,
  ) {
    const pts = [from];
    let a = angle;
    let p = from;
    for (let i = 0; i < steps; i++) {
      a += (rnd() - 0.5) * bend;
      p = { x: p.x + Math.cos(a) * step, y: p.y + Math.sin(a) * step };
      pts.push(p);
      if (depth < 3 && i >= 1 && i < steps - 1 && rnd() < forks) {
        const side = rnd() < 0.5 ? -1 : 1;
        const rest = Math.max(2, steps - i - 1);
        grow(rnd, p, a + side * (0.45 + rnd() * 0.7), rest, step * 0.8, depth + 1, out, bend, forks * 0.8);
      }
    }
    out.push({ pts, depth });
  }

  function pulse(parent: Element, d: string, duration: number, delay: number) {
    const path = make("path", { d, class: "pulse", pathLength: 1000 }, parent);
    path.style.animationDuration = `${duration}s`;
    path.style.animationDelay = `${delay}s`;
  }

  // Each piece waits, undrawn, until the reader reaches its top.
  let pieces: { el: Element; top: number; bottom: number }[] = [];

  function build() {
    if (!svg || !host) return;
    const rnd = random(0x48595048);
    const box = host.getBoundingClientRect();
    const w = host.clientWidth;
    const h = host.scrollHeight;
    const narrow = w < 760;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    svg.setAttribute("width", String(w));
    svg.setAttribute("height", String(h));

    const webs = svg.querySelector(".weave-webs")!;
    const thread = svg.querySelector(".weave-thread")!;
    const ties = svg.querySelector(".weave-ties")!;
    for (const g of [webs, thread, ties]) g.replaceChildren();
    pieces = [];

    const rect = (el: Element) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - box.left, y: r.top - box.top, w: r.width, h: r.height };
    };
    const centre = (el: Element) => {
      const r = rect(el);
      return { x: r.x + r.w / 2, y: r.y + r.h / 2 };
    };
    const piece = (parent: Element, top: number, bottom = top) => {
      const g = make("g", { class: "piece" }, parent);
      pieces.push({ el: g, top, bottom });
      return g;
    };

    const blooms = [...host.querySelectorAll<HTMLElement>("[data-bloom]")].filter(
      (b) => b.offsetWidth > 0,
    );
    const sections = [...host.querySelectorAll<HTMLElement>("[data-weave]")];
    const first = blooms[0];
    const endBloom = blooms.find((b) => b.dataset.bloom === "end");

    // Webs: many arms from the centre, filling the element. A branch stops where it leaves
    // the ellipse inside the element's box, so the web ends raggedly, not on a straight
    // edge. Each branch starts later the further out it is, so a web opens rather than
    // appears.
    for (const b of blooms) {
      const r = rect(b);
      const c = centre(b);
      const radius = Math.max(r.w, r.h) * 0.5;
      const inside = (p: P) => ((p.x - c.x) / (r.w / 2)) ** 2 + ((p.y - c.y) / (r.h / 2)) ** 2 <= 1;
      const fit = (pts: P[]) => {
        const out: P[] = [];
        for (const p of pts) {
          const q = { x: c.x + p.x * radius, y: c.y + p.y * radius };
          out.push(q);
          if (!inside(q)) break;
        }
        return out;
      };
      const arms = narrow ? 16 : 30;
      const g = piece(webs, b === endBloom ? c.y - r.h / 4 : r.y, r.y + r.h);
      let lit = 0;
      for (let i = 0; i < arms; i++) {
        const angle = (i / arms) * Math.PI * 2 + rnd() * 0.3;
        const out: Branch[] = [];
        const step = (0.7 + rnd() * 0.4) / 9;
        grow(rnd, { x: 0, y: 0 }, angle, 6 + Math.floor(rnd() * 3), step, 0, out, 0.8, 0.45);
        for (const br of out) br.pts = fit(br.pts);
        for (const br of out) {
          if (br.pts.length < 2) continue;
          const path = make(
            "path",
            { d: smooth(br.pts), class: `filament depth-${br.depth}`, pathLength: 1 },
            g,
          );
          path.style.transitionDelay = `${0.15 + br.depth * 0.35 + rnd() * 0.25}s`;
          const tip = br.pts[br.pts.length - 1];
          if (br.depth > 0 && rnd() < 0.3) {
            const dot = make(
              "circle",
              {
                cx: f(tip.x),
                cy: f(tip.y),
                r: f(1.4 + rnd() * 2),
                class: rnd() < 0.25 ? "spore lit" : "spore",
              },
              g,
            );
            dot.style.transitionDelay = `${0.9 + br.depth * 0.35}s`;
          }
        }
        // A few signals, on the longest arms.
        const longest = out[out.length - 1].pts;
        if (longest.length > 2 && lit < (narrow ? 4 : 7) && rnd() < 0.45) {
          pulse(g, smooth(longest), 3 + rnd() * 2.5, rnd() * 5);
          lit++;
        }
      }
    }

    // The lanes sit just outside the sections' text.
    const content = host.querySelector<HTMLElement>("[data-weave] .wrap");
    const inner = content ? rect(content) : { x: 0, y: 0, w, h };
    const pad = content ? parseFloat(getComputedStyle(content).paddingLeft) : 0;
    const laneX = (side: string) =>
      narrow
        ? 14
        : side === "right"
          ? Math.min(w - 16, inner.x + inner.w - pad + 34)
          : Math.max(16, inner.x + pad - 34);

    // The thread: out of the bottom of the hero's web, then lane by lane.
    const pts: P[] = [];
    const breaks: number[] = [];
    if (first) {
      const r = rect(first);
      pts.push(
        { x: r.x + r.w / 2, y: r.y + r.h * 0.8 },
        { x: r.x + r.w / 2 + 12, y: r.y + r.h - 20 },
      );
    }
    let last: P | undefined = pts[pts.length - 1];
    for (const s of sections) {
      const r = rect(s);
      const x = laneX(s.dataset.weave ?? "left");
      const heading = s.querySelector("h2");
      const knot = heading ? centre(heading).y : r.y + 60;
      const top = r.y + 8;
      const bottom = r.y + r.h - 8;
      // Crossing to the other lane, each swing takes its own path through the gap.
      if (last && Math.abs(last.x - x) > 40) {
        pts.push({
          x: (last.x + x) / 2 + (rnd() - 0.5) * Math.abs(last.x - x) * 0.5,
          y: (last.y + top) / 2 + (rnd() - 0.5) * 40,
        });
      }
      breaks.push(pts.length);
      pts.push({ x, y: top });
      // A slight wander down the lane, so it reads as grown rather than ruled.
      const lane: P[] = [{ x, y: knot }];
      for (let y = top + 160; y < bottom - 80; y += 180 + rnd() * 60) {
        if (Math.abs(y - knot) > 60) lane.push({ x: x + (rnd() - 0.5) * 14, y });
      }
      pts.push(...lane.toSorted((a, b) => a.y - b.y));
      last = { x: x + (rnd() - 0.5) * 10, y: bottom };
      pts.push(last);
    }
    if (endBloom) {
      // Swing across above the closing section, then into its web.
      const end = centre(endBloom);
      const section = endBloom.closest("section");
      breaks.push(pts.length);
      if (section) pts.push({ x: end.x + 60, y: rect(section).y + 10 });
      pts.push(end);
    }

    // Drawn in stretches, one per section, each when the reader gets there.
    if (pts.length > 1) {
      const segs = curves(pts);
      const starts = [
        0,
        ...breaks.filter((b) => b > 0 && b < pts.length - 1),
        pts.length - 1,
      ];
      for (let i = 0; i < starts.length - 1; i++) {
        const a = starts[i];
        const z = starts[i + 1];
        if (z <= a) continue;
        const d = `M${f(pts[a].x)},${f(pts[a].y)} ${segs.slice(a, z).join(" ")}`;
        const g = piece(thread, pts[a].y, pts[z].y);
        const path = make("path", { d, class: "strand", pathLength: 1 }, g);
        const seconds = Math.min(2.4, Math.max(0.8, (pts[z].y - pts[a].y) / 700));
        path.style.transitionDuration = `${seconds}s`;
      }
    }

    // Knots where the thread passes each section's heading.
    for (const s of sections) {
      const heading = s.querySelector("h2");
      if (!heading) continue;
      const y = centre(heading).y;
      const x = laneX(s.dataset.weave ?? "left");
      const g = piece(ties, y);
      make("circle", { cx: f(x), cy: f(y), r: 6, class: "knot" }, g);
      make("circle", { cx: f(x), cy: f(y), r: 2.4, class: "knot-core" }, g);
    }

    // Ties: from a hub (or the thread) to each element that names it.
    const hubs = new Map<string, HTMLElement>();
    for (const el of host.querySelectorAll<HTMLElement>("[data-hub]")) {
      hubs.set(el.dataset.hub!, el);
    }
    for (const el of host.querySelectorAll<HTMLElement>("[data-tie]")) {
      const r = rect(el);
      const c = centre(el);
      const hub = el.dataset.tie === "thread" ? undefined : hubs.get(el.dataset.tie!);
      let from: P;
      let to: P;
      let d: string;
      if (hub) {
        // Where the line between the centres leaves each box.
        const hr = rect(hub);
        const hc = centre(hub);
        to = { x: clamp(hc.x, r.x, r.x + r.w), y: clamp(hc.y, r.y, r.y + r.h) };
        from = {
          x: clamp(c.x, hr.x + 8, hr.x + hr.w - 8),
          y: clamp(c.y, hr.y + 8, hr.y + hr.h - 8),
        };
        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const bend = (rnd() - 0.5) * 0.35;
        d = `M${f(from.x)},${f(from.y)} C${f(from.x + dx * 0.33 - dy * bend)},${f(from.y + dy * 0.33 + dx * bend)} ${f(from.x + dx * 0.66 + dy * bend)},${f(from.y + dy * 0.66 - dx * bend)} ${f(to.x)},${f(to.y)}`;
      } else {
        // Hangs from the thread's lane, a little above the element.
        const section = el.closest<HTMLElement>("[data-weave]");
        to = { x: r.x + 18, y: r.y };
        from = { x: laneX(section?.dataset.weave ?? "left"), y: r.y - 44 };
        d = `M${f(from.x)},${f(from.y)} C${f(from.x + (to.x - from.x) * 0.55)},${f(from.y)} ${f(to.x)},${f(to.y - 28)} ${f(to.x)},${f(to.y)}`;
      }
      const g = piece(ties, Math.min(from.y, to.y), Math.max(from.y, to.y));
      make("path", { d, class: "tie", pathLength: 1 }, g);
      make("circle", { cx: f(to.x), cy: f(to.y), r: 3.4, class: "knot small" }, g);
      if (hub) pulse(g, d, 2.6 + rnd() * 1.8, rnd() * 3);
    }

    // A frame later, so what's already in view draws in rather than appearing.
    requestAnimationFrame(update);
  }

  // Draws what the reader has reached, and lets signals run only near the viewport.
  function update() {
    if (!host) return;
    const offset = host.getBoundingClientRect().top;
    const reach = still.matches ? Infinity : innerHeight * 0.8 - offset;
    const near = -offset - 300;
    const far = -offset + innerHeight + 300;
    for (const p of pieces) {
      p.el.classList.toggle("on", p.top <= reach);
      p.el.classList.toggle("live", p.bottom >= near && p.top <= far);
    }
  }

  if (svg && host) {
    let frame = 0;
    let queued: "build" | "update" | undefined;
    const schedule = (what: "build" | "update") => {
      if (queued === "build") return;
      queued = what;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const run = queued;
        queued = undefined;
        if (run === "build") build();
        else update();
      });
    };
    let width = host.clientWidth;
    let height = host.scrollHeight;
    new ResizeObserver(() => {
      if (host.clientWidth === width && host.scrollHeight === height) return;
      width = host.clientWidth;
      height = host.scrollHeight;
      schedule("build");
    }).observe(host);
    addEventListener("scroll", () => schedule("update"), { passive: true });
    still.addEventListener("change", () => schedule("build"));
    document.fonts.ready.then(() => schedule("build"));
    build();
  }
</script>

<style>
  .weave {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  .weave :global(path) {
    fill: none;
    stroke-linecap: round;
  }

  /* Every line draws itself in once its piece is reached. */
  .weave :global(.strand),
  .weave :global(.filament),
  .weave :global(.tie) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.3, 0.6, 0.2, 1);
  }

  .weave :global(.on .strand),
  .weave :global(.on .filament),
  .weave :global(.on .tie) {
    stroke-dashoffset: 0;
  }

  .weave :global(.strand) {
    stroke: var(--thread);
    stroke-width: 1.6;
    transition-timing-function: linear;
  }

  .weave :global(.filament) {
    stroke: var(--thread);
    stroke-width: 1;
    opacity: 0.28;
    transition-duration: 1.6s;
  }

  .weave :global(.filament.depth-0) {
    stroke-width: 1.6;
    opacity: 0.62;
  }

  .weave :global(.filament.depth-1) {
    stroke-width: 1.2;
    opacity: 0.44;
  }

  .weave :global(.tie) {
    stroke: var(--thread);
    stroke-width: 1.2;
    opacity: 0.7;
  }

  .weave :global(.knot) {
    fill: var(--bg);
    stroke: var(--thread);
    stroke-width: 1.5;
  }

  .weave :global(.knot-core),
  .weave :global(.spore.lit) {
    fill: var(--signal);
  }

  .weave :global(.spore) {
    fill: var(--thread);
  }

  .weave :global(.knot),
  .weave :global(.knot-core),
  .weave :global(.spore) {
    opacity: 0;
    transition: opacity 0.6s 0.6s;
  }

  .weave :global(.on .knot),
  .weave :global(.on .knot-core),
  .weave :global(.on .spore.lit) {
    opacity: 1;
  }

  .weave :global(.on .spore) {
    opacity: 0.5;
  }

  /* A signal: a short lit stretch running out along its path, only near the viewport. */
  .weave :global(.pulse) {
    stroke: var(--signal);
    stroke-width: 2.2;
    stroke-dasharray: 90 1100;
    stroke-dashoffset: 90;
    visibility: hidden;
    animation: signal linear infinite paused;
  }

  .weave :global(.on.live .pulse) {
    visibility: visible;
    animation-play-state: running;
  }

  @keyframes signal {
    to {
      stroke-dashoffset: -1010;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weave :global(.pulse) {
      display: none;
    }
  }
</style>
