---
import wordmarkDark from "../../../admin/public/brand/hypha-wordmark-on-dark.svg?url";
import wordmark from "../../../admin/public/brand/hypha-wordmark.svg?url";
import { DEMO_ADMIN, DEMO_LOGIN, DEMO_STORE, GITHUB, SPONSOR } from "../consts";

const links = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/api/admin", label: "API" },
  { href: "/blog", label: "Blog" },
  { href: "/changelog", label: "Changelog" },
  { href: GITHUB, label: "GitHub" },
];
const path = Astro.url.pathname;
const current = (href: string) => href.startsWith("/") && path.startsWith(href);
---

<header class="header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Hypha home">
      <img class="on-light" src={wordmark} alt="Hypha" width="104" height="33" />
      <img class="on-dark" src={wordmarkDark} alt="Hypha" width="104" height="33" />
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <details class="demo">
            <summary>Demo <span class="chevron" aria-hidden="true"></span></summary>
            <div class="panel">
              <p>Mycelium Works, a demo store. The admin is read-only.</p>
              <a href={DEMO_STORE}>Open the store <span>→</span></a>
              <a href={DEMO_ADMIN}>Open the admin <span>→</span></a>
              <dl>
                <dt>Email</dt>
                <dd><code>{DEMO_LOGIN.email}</code></dd>
                <dt>Password</dt>
                <dd><code>{DEMO_LOGIN.password}</code></dd>
              </dl>
            </div>
          </details>
        </li>
      </ul>
    </nav>
    <button class="theme" type="button" aria-label="Dark theme" aria-pressed="false">
      <span aria-hidden="true"></span>
    </button>
    <a class="quiet" href={SPONSOR}>Sponsor</a>
    <a class="cta" href="/docs/getting-started">Get started</a>
    <details class="menu">
      <summary>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href={DEMO_STORE}>Demo store</a></li>
        <li><a href={DEMO_ADMIN}>Demo admin</a></li>
        <li class="login">
          Admin login<br />
          <code>{DEMO_LOGIN.email}</code> / <code>{DEMO_LOGIN.password}</code>
        </li>
        <li><a href="/docs/getting-started">Get started</a></li>
        <li><a href={SPONSOR}>Sponsor</a></li>
      </ul>
    </details>
  </div>
</header>

<script>
  // The demo panel closes like a menu: on a click elsewhere or Escape.
  const demo = document.querySelector<HTMLDetailsElement>(".header .demo");
  document.addEventListener("click", (e) => {
    if (demo?.open && !demo.contains(e.target as Node)) demo.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && demo?.open) demo.open = false;
  });

  // Shares Starlight's key, so the docs open in the theme chosen here.
  const button = document.querySelector<HTMLButtonElement>(".header .theme");
  const sync = () =>
    button?.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
  sync();
  button?.addEventListener("click", () => {
    const dark = document.documentElement.dataset.theme !== "dark";
    if (dark) document.documentElement.dataset.theme = "dark";
    else delete document.documentElement.dataset.theme;
    try {
      localStorage.setItem("starlight-theme", dark ? "dark" : "light");
    } catch {}
    sync();
  });
</script>

<style>
  /* Follows the reader down the page. Translucent without a backdrop blur: blur over the
     landing page's drawing would repaint on every scroll. */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule);
    background: var(--header-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 1200px;
    min-height: 64px;
    padding-inline: 20px;
  }

  .logo {
    margin-right: 20px;
  }

  .logo img {
    width: auto;
    height: 24px;
  }

  .on-dark,
  :global([data-theme="dark"]) .on-light {
    display: none;
  }

  :global([data-theme="dark"]) .on-dark {
    display: block;
  }

  nav {
    margin-right: auto;
  }

  .links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .quiet {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
  }

  .quiet {
    padding: 9px 12px;
    border-radius: 10px;
  }

  .links a:hover,
  .links a[aria-current="page"],
  .quiet:hover,
  .demo summary:hover,
  .demo[open] summary {
    color: var(--text);
    background: var(--muted);
  }

  .demo {
    position: relative;
  }

  .demo summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 14px;
    list-style: none;
    cursor: pointer;
  }

  .demo summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .demo[open] .chevron {
    margin-top: 3px;
    transform: rotate(225deg);
  }

  .panel {
    position: absolute;
    left: 0;
    top: calc(100% + 10px);
    z-index: 5;
    width: 300px;
    padding: 8px;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(26 27 25 / 0.12);
  }

  .panel p {
    margin: 0;
    padding: 8px 12px 10px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .panel a {
    display: flex;
    justify-content: space-between;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .panel a:hover {
    background: var(--muted);
  }

  .panel a span {
    color: var(--text-muted);
  }

  .panel dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    align-items: center;
    margin: 6px 0 0;
    padding: 12px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
  }

  .panel dt {
    color: var(--text-muted);
  }

  .panel dd,
  .login {
    margin: 0;
  }

  .panel code,
  .login code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    user-select: all;
  }

  .login {
    padding: 12px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .theme:hover {
    background: var(--muted);
  }

  .theme span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .cta {
    padding: 9px 16px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--ink-on-lime);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta:hover {
    background: var(--accent-hover);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    list-style: none;
    cursor: pointer;
  }

  .bars {
    width: 16px;
    height: 10px;
    border-block: 1.5px solid var(--text);
    background: linear-gradient(var(--text), var(--text)) center / 100% 1.5px no-repeat;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 5;
    min-width: 220px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(26 27 25 / 0.12);
  }

  .menu a {
    display: block;
    padding: 12px;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .menu a:hover {
    background: var(--muted);
  }

  @media (max-width: 820px) {
    .bar nav,
    .bar .quiet {
      display: none;
    }

    .theme {
      margin-left: auto;
    }

    .menu {
      display: block;
    }
  }
</style>
