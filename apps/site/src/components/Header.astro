---
import wordmarkDark from "../../../admin/public/brand/hypha-wordmark-on-dark.svg?url";
import wordmark from "../../../admin/public/brand/hypha-wordmark.svg?url";
import { GITHUB, SPONSOR } from "../consts";

const links = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/api/admin", label: "API" },
  { href: "/blog", label: "Blog" },
  { href: "/changelog", label: "Changelog" },
  { href: GITHUB, label: "GitHub" },
];
const path = Astro.url.pathname;
const current = (href: string) => href.startsWith("/") && path.startsWith(href);
---

<header class="header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Hypha home">
      <img class="on-light" src={wordmark} alt="Hypha" width="104" height="33" />
      <img class="on-dark" src={wordmarkDark} alt="Hypha" width="104" height="33" />
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme" type="button" aria-label="Dark theme" aria-pressed="false">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
    </button>
    <a class="button primary sponsor" href={SPONSOR}>Sponsor</a>
    <details class="menu">
      <summary>Menu</summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href={SPONSOR}>Sponsor</a></li>
      </ul>
    </details>
  </div>
</header>

<script>
  // Shares Starlight's key, so the docs open in the theme chosen here.
  const button = document.querySelector<HTMLButtonElement>(".header .theme");
  const sync = () =>
    button?.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
  sync();
  button?.addEventListener("click", () => {
    const dark = document.documentElement.dataset.theme !== "dark";
    if (dark) document.documentElement.dataset.theme = "dark";
    else delete document.documentElement.dataset.theme;
    try {
      localStorage.setItem("starlight-theme", dark ? "dark" : "light");
    } catch {}
    sync();
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 68px;
  }

  .logo img {
    width: 104px;
    height: auto;
  }

  .on-dark,
  :global([data-theme="dark"]) .on-light {
    display: none;
  }

  :global([data-theme="dark"]) .on-dark {
    display: block;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-right: -14px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--text);
    border-color: var(--rule-strong);
  }

  .theme[aria-pressed="true"] svg path {
    fill: currentColor;
  }

  nav {
    margin-left: auto;
  }

  .links {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--text);
  }

  .sponsor {
    min-height: 38px;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 5;
    min-width: 200px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(26 27 25 / 0.12);
  }

  .menu a {
    display: block;
    padding: 10px 12px;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .menu a:hover {
    background: var(--bg-sunk);
  }

  @media (max-width: 760px) {
    /* `.bar` outweighs the global `.button`, which scoped styles don't. */
    .bar nav,
    .bar .sponsor {
      display: none;
    }

    .menu {
      display: block;
    }

    .theme {
      margin-left: auto;
      margin-right: 0;
    }
  }
</style>
