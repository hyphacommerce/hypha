---
// What plugs into Hypha's core and how: spores compiled in, apps over HTTP, agents over
// MCP, frontends over the two APIs. Drawn at desktop widths; phones get the same as a list.
const parts = [
  {
    name: "Spores",
    how: "Rust crates compiled into the API: payment providers, integrations, event handlers, routes. Trusted code the operator chose to build in.",
  },
  {
    name: "Apps",
    how: "Services in any language, installed over OAuth 2.1. They get webhooks, answer extension points (payments, shipping rates, search) and add blocks to the admin and elements to the storefront.",
  },
  {
    name: "AI agents",
    how: "Connect over MCP with their own scopes. Any write can be previewed exactly; writes held for approval wait for a person.",
  },
  {
    name: "Frontends",
    how: "The admin panel and storefront that ship with Hypha, or your own on the typed SDK.",
  },
];
---

<div class="arch">
  <svg viewBox="0 0 960 440" role="img" aria-labelledby="arch-title">
    <title id="arch-title">
      Hypha's core, with spores compiled in on the left, apps over HTTP on the right, AI agents
      over MCP above, and frontends over the admin and storefront APIs below.
    </title>
    <g class="filaments" fill="none">
      <path d="M300 220 C 250 220, 240 190, 170 190" />
      <path d="M300 220 C 250 220, 240 250, 170 250" />
      <path d="M660 220 C 710 220, 720 190, 790 190" />
      <path d="M660 220 C 710 220, 720 250, 790 250" />
      <path d="M480 160 C 480 120, 470 100, 480 70" />
      <path d="M480 280 C 480 320, 490 340, 480 370" />
    </g>
    <g class="core">
      <rect x="300" y="160" width="360" height="120" rx="14"></rect>
      <text x="480" y="208" text-anchor="middle" class="t-core">Hypha core</text>
      <text x="480" y="236" text-anchor="middle" class="t-sub">
        commands with typed input, scopes and errors
      </text>
      <text x="480" y="258" text-anchor="middle" class="t-sub">
        events, the outbox, Postgres or Workers
      </text>
    </g>
    <g class="node">
      <rect x="20" y="160" width="150" height="120" rx="12"></rect>
      <text x="95" y="206" text-anchor="middle" class="t-name">Spores</text>
      <text x="95" y="232" text-anchor="middle" class="t-sub">Rust, compiled</text>
      <text x="95" y="252" text-anchor="middle" class="t-sub">into the API</text>
    </g>
    <g class="node">
      <rect x="790" y="160" width="150" height="120" rx="12"></rect>
      <text x="865" y="206" text-anchor="middle" class="t-name">Apps</text>
      <text x="865" y="232" text-anchor="middle" class="t-sub">any language,</text>
      <text x="865" y="252" text-anchor="middle" class="t-sub">over HTTP</text>
    </g>
    <g class="node">
      <rect x="360" y="14" width="240" height="56" rx="12"></rect>
      <text x="480" y="48" text-anchor="middle" class="t-name">AI agents, over MCP</text>
    </g>
    <g class="node">
      <rect x="300" y="370" width="360" height="56" rx="12"></rect>
      <text x="480" y="404" text-anchor="middle" class="t-name">
        Admin, storefront, your own frontend
      </text>
    </g>
  </svg>

  <ul class="parts">
    {
      parts.map((p) => (
        <li>
          <h3>{p.name}</h3>
          <p>{p.how}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  svg {
    width: 100%;
    height: auto;
    color: var(--text);
  }

  .filaments path {
    stroke: var(--text-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .core rect {
    fill: var(--lime);
  }

  .core text {
    fill: var(--ink-on-lime);
  }

  .node rect {
    fill: var(--bg-raised);
    stroke: var(--rule-strong);
  }

  text {
    fill: currentColor;
    font-family: var(--font-sans);
  }

  .t-core {
    font-size: 24px;
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .t-name {
    font-size: 17px;
    font-weight: 620;
  }

  .t-sub {
    font-size: 14px;
    opacity: 0.8;
  }

  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 48px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .parts h3 {
    font-size: 1.05rem;
  }

  .parts p {
    margin-top: 6px;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    svg {
      display: none;
    }

    .parts {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
  }
</style>
