---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-head">
  <h1>{title}</h1>
  {lede && <p>{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-block: clamp(48px, 7vw, 88px) 32px;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    letter-spacing: -0.035em;
  }

  p {
    margin-top: 14px;
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 1.08rem;
  }
</style>
