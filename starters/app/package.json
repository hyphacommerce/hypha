{
  "name": "app-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A starter for an app on Hypha's apps platform: installed over OAuth, answering webhooks and an extension point, on Node or Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/node.ts",
    "start": "node src/node.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hyphacommerce/app": "workspace:*",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24"
  }
}
